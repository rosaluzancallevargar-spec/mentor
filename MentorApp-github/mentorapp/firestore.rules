rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function ok(){return request.auth!=null}
 function adminMail(){return request.auth.token.email in ['TU_CORREO_ADMIN@gmail.com']&&request.auth.token.email_verified==true}
 function adm(){return ok()&&get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role=='admin'}
 function mem(){return request.auth.uid in resource.data.members}
 match /users/{id}{allow read:if ok();
  allow create:if adm()||ok()&&request.auth.uid==id&&request.resource.data.active==true&&(request.resource.data.role in ['student','mentor']||(request.resource.data.role=='admin'&&adminMail()));
  allow update:if adm()||(request.auth.uid==id&&request.resource.data.role==resource.data.role&&request.resource.data.active==resource.data.active);
  allow delete:if adm();}
 match /requests/{id}{allow read:if adm()||(ok()&&mem());
  allow create:if adm()||(ok()&&request.auth.uid==request.resource.data.student&&request.resource.data.status=='PENDIENTE');
  allow update:if adm()||(ok()&&mem()&&(resource.data.mentor==request.auth.uid||request.resource.data.status==resource.data.status));
  allow delete:if adm();}
 match /chats/{id}{allow read:if adm()||(ok()&&mem());allow create,update:if ok()&&request.auth.uid in request.resource.data.members;}
 match /messages/{id}{allow read:if ok()&&mem();
  allow create:if ok()&&request.resource.data.from==request.auth.uid&&request.auth.uid in request.resource.data.members;}
 match /notifications/{id}{allow read,update:if adm()||(ok()&&resource.data.to==request.auth.uid);allow create:if ok();}
 match /ratings/{id}{allow read:if ok();allow create:if ok()&&request.resource.data.student==request.auth.uid;}
 match /materials/{id}{allow read:if ok();allow create:if ok()&&request.resource.data.mentor==request.auth.uid&&get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role=='mentor';allow delete:if adm()||(ok()&&resource.data.mentor==request.auth.uid);}
 match /doubts/{id}{allow read:if ok()&&(resource.data.student==request.auth.uid||get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role in ['mentor','admin']);
  allow create:if ok()&&request.resource.data.student==request.auth.uid;
  allow update:if ok()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies','status'])&&(resource.data.student==request.auth.uid||get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role=='mentor');
  allow delete:if adm()||(ok()&&resource.data.student==request.auth.uid);}
}}
